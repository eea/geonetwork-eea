    <skos:prefLabel xml:lang="en">Aviation</skos:prefLabel>
    <skos:notation>aviation</skos:notation>
    <skos:definition xml:lang="en">Air transport activity and associated environmental data.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/transport_mobility" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/transport_mobility/maritime_inland_waterway_transport">
    <skos:prefLabel xml:lang="en">Maritime &amp; Inland Waterway Transport</skos:prefLabel>
    <skos:notation>maritime_inland_waterway_transport</skos:notation>
    <skos:definition xml:lang="en">Sea and inland-waterway transport activity and associated environmental data.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/transport_mobility" />
