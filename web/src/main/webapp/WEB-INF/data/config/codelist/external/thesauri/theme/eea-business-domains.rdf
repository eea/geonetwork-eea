    <skos:notation>cross_modal_mobility_transport_systems</skos:notation>
    <skos:definition xml:lang="en">Mobility demand, modal split, infrastructure and system-level information spanning multiple transport modes.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/transport_mobility" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/reference_data">
    <skos:prefLabel xml:lang="en">Reference Data</skos:prefLabel>
    <skos:notation>reference_data</skos:notation>
    <skos:definition xml:lang="en">Cross-cutting reference datasets that are not tied to one environmental topic and that every business domain joins against, such as administrative and statistical boundaries (NUTS, LAU), basemaps, elevation models and reference grids.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:topConceptOf rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/reference_data/administrative_boundaries" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/reference_data/basemaps" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/reference_data/elevation" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/reference_data/reference_grids" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/reference_data/administrative_boundaries">
    <skos:prefLabel xml:lang="en">Administrative Boundaries</skos:prefLabel>
    <skos:notation>administrative_boundaries</skos:notation>
    <skos:definition xml:lang="en">Administrative and statistical units and boundaries (NUTS, LAU, countries, functional urban areas, degree of urbanisation).</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/reference_data" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/reference_data/basemaps">
    <skos:prefLabel xml:lang="en">Basemaps</skos:prefLabel>
    <skos:notation>basemaps</skos:notation>
    <skos:definition xml:lang="en">Background maps, map templates and image mosaics used for display and orientation.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/reference_data" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/reference_data/elevation">
    <skos:prefLabel xml:lang="en">Elevation</skos:prefLabel>
    <skos:notation>elevation</skos:notation>
    <skos:definition xml:lang="en">Digital elevation and terrain models and their derivatives.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/reference_data" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/reference_data/reference_grids">
    <skos:prefLabel xml:lang="en">Reference Grids</skos:prefLabel>
    <skos:notation>reference_grids</skos:notation>
    <skos:definition xml:lang="en">Standard spatial grids and gridded reference layers (EEA reference grid, EMEP grid, population grids).</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/reference_data" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/non_domain_datasets">
    <skos:prefLabel xml:lang="en">Non-domain Datasets</skos:prefLabel>
    <skos:notation>non_domain_datasets</skos:notation>
    <skos:definition xml:lang="en">Datasets that are not about the environment but serve to run the Data Lakehouse itself: system tables, control lists and other administrative data.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:topConceptOf rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/non_domain_datasets/system" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/non_domain_datasets/system">
    <skos:prefLabel xml:lang="en">System</skos:prefLabel>
    <skos:notation>system</skos:notation>
    <skos:definition xml:lang="en">System tables, control lists and administrative views used to manage the Data Lakehouse.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/non_domain_datasets" />
  </skos:Concept>
</rdf:RDF>

