<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/">
  <skos:ConceptScheme rdf:about="https://sdi.eea.europa.eu/registry/business-domains">
    <dc:title xml:lang="en">EEA business domains and subdomains</dc:title>
    <dc:description xml:lang="en">Business domains (level 1) and subdomains (level 2) of the EEA Data Lakehouse, used to classify EEA SDI records.</dc:description>
    <dc:creator>European Environment Agency</dc:creator>
    <dcterms:issued>2026-10-13</dcterms:issued>
    <dcterms:modified>2026-10-13</dcterms:modified>
    <skos:hasTopConcept rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy" />
    <skos:hasTopConcept rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation" />
    <skos:hasTopConcept rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems" />
    <skos:hasTopConcept rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry" />
    <skos:hasTopConcept rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management" />
    <skos:hasTopConcept rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/marine_coastal_fisheries" />
    <skos:hasTopConcept rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/pollution_environmental_health" />
