    <skos:hasTopConcept rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/transport_mobility" />
    <skos:hasTopConcept rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/reference_data" />
    <skos:hasTopConcept rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/non_domain_datasets" />
  </skos:ConceptScheme>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy">
    <skos:prefLabel xml:lang="en">Climate Change Mitigation and Energy</skos:prefLabel>
    <skos:notation>climate_change_mitigation_energy</skos:notation>
    <skos:definition xml:lang="en">Greenhouse-gas mitigation and the transition of energy systems towards climate neutrality. Includes emissions and removals, inventories and projections, mitigation policies and measures, climate targets, renewable energy, energy efficiency, energy production and consumption, and related transition information.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:topConceptOf rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy/greenhouse_gas_emissions" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy/energy_production_supply" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy/energy_use_efficiency" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy/energy_transition_decarbonisation" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy/greenhouse_gas_emissions">
    <skos:prefLabel xml:lang="en">Greenhouse Gas Emissions</skos:prefLabel>
    <skos:notation>greenhouse_gas_emissions</skos:notation>
    <skos:definition xml:lang="en">Emissions and removals of greenhouse gases, including their magnitude, sources and sinks.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy/energy_production_supply">
    <skos:prefLabel xml:lang="en">Energy Production &amp; Supply</skos:prefLabel>
    <skos:notation>energy_production_supply</skos:notation>
    <skos:definition xml:lang="en">Energy generation, transformation, supply and energy-system inputs.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy/energy_use_efficiency">
    <skos:prefLabel xml:lang="en">Energy Use &amp; Efficiency</skos:prefLabel>
    <skos:notation>energy_use_efficiency</skos:notation>
    <skos:definition xml:lang="en">Energy consumption, demand and efficiency across sectors and activities.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy/energy_transition_decarbonisation">
    <skos:prefLabel xml:lang="en">Energy Transition &amp; Decarbonisation</skos:prefLabel>
    <skos:notation>energy_transition_decarbonisation</skos:notation>
    <skos:definition xml:lang="en">Structural transition of the energy system and progress toward low-carbon/decarbonised energy and mitigation outcomes.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_mitigation_energy" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation">
    <skos:prefLabel xml:lang="en">Climate Change Impacts, Risks and Adaptation</skos:prefLabel>
    <skos:notation>climate_change_impacts_risks_adaptation</skos:notation>
    <skos:definition xml:lang="en">Observed and projected climate-change impacts, climate-related risks and vulnerabilities, and measures to strengthen adaptation and resilience.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:topConceptOf rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation/climate_hazards_extremes" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation/climate_impacts_vulnerability" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation/climate_risk" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation/adaptation_resilience" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation/climate_hazards_extremes">
    <skos:prefLabel xml:lang="en">Climate Hazards &amp; Extremes</skos:prefLabel>
    <skos:notation>climate_hazards_extremes</skos:notation>
    <skos:definition xml:lang="en">Climate-related physical hazards and extreme events.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation/climate_impacts_vulnerability">
    <skos:prefLabel xml:lang="en">Climate Impacts &amp; Vulnerability</skos:prefLabel>
    <skos:notation>climate_impacts_vulnerability</skos:notation>
    <skos:definition xml:lang="en">Observed or projected impacts on environmental, social and economic systems and their vulnerability.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation/climate_risk">
    <skos:prefLabel xml:lang="en">Climate Risk</skos:prefLabel>
    <skos:notation>climate_risk</skos:notation>
    <skos:definition xml:lang="en">Risk information combining hazards, exposure and vulnerability.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation/adaptation_resilience">
    <skos:prefLabel xml:lang="en">Adaptation &amp; Resilience</skos:prefLabel>
    <skos:notation>adaptation_resilience</skos:notation>
    <skos:definition xml:lang="en">Measures, capacities and outcomes related to adapting to climate change and building resilience.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/climate_change_impacts_risks_adaptation" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems">
    <skos:prefLabel xml:lang="en">Biodiversity and Ecosystems</skos:prefLabel>
    <skos:notation>biodiversity_ecosystems</skos:notation>
    <skos:definition xml:lang="en">Biodiversity and the state, condition, distribution, protection and restoration of species, habitats and ecosystems.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:topConceptOf rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems/species" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems/habitats_ecosystems" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems/protected_areas" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems/ecosystem_condition_restoration" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems/invasive_alien_species" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems/species">
    <skos:prefLabel xml:lang="en">Species</skos:prefLabel>
    <skos:notation>species</skos:notation>
    <skos:definition xml:lang="en">Species occurrence, distribution, status, trends and conservation.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems/habitats_ecosystems">
    <skos:prefLabel xml:lang="en">Habitats &amp; Ecosystems</skos:prefLabel>
    <skos:notation>habitats_ecosystems</skos:notation>
    <skos:definition xml:lang="en">Habitat and ecosystem extent, condition, distribution and characteristics.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems/protected_areas">
    <skos:prefLabel xml:lang="en">Protected Areas</skos:prefLabel>
    <skos:notation>protected_areas</skos:notation>
    <skos:definition xml:lang="en">Spatial and descriptive information on protected and conserved areas and networks.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems/ecosystem_condition_restoration">
    <skos:prefLabel xml:lang="en">Ecosystem Condition &amp; Restoration</skos:prefLabel>
    <skos:notation>ecosystem_condition_restoration</skos:notation>
    <skos:definition xml:lang="en">Condition, degradation, restoration needs, measures and outcomes for ecosystems.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems/invasive_alien_species">
    <skos:prefLabel xml:lang="en">Invasive Alien Species</skos:prefLabel>
    <skos:notation>invasive_alien_species</skos:notation>
    <skos:definition xml:lang="en">Occurrence, spread, impacts and management of invasive alien species.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/biodiversity_ecosystems" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry">
    <skos:prefLabel xml:lang="en">Land, Agriculture, Soil and Forestry</skos:prefLabel>
    <skos:notation>land_agriculture_soil_forestry</skos:notation>
    <skos:definition xml:lang="en">Terrestrial land systems, their use, management and change, including land cover and land use, agriculture, soils, forests and forestry.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:topConceptOf rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry/land_cover_land_use" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry/soil" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry/agriculture_food_systems" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry/forests_forestry" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry/land_cover_land_use">
    <skos:prefLabel xml:lang="en">Land Cover &amp; Land Use</skos:prefLabel>
    <skos:notation>land_cover_land_use</skos:notation>
    <skos:definition xml:lang="en">Land cover, land use, land-use change and spatial land patterns.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry/soil">
    <skos:prefLabel xml:lang="en">Soil</skos:prefLabel>
    <skos:notation>soil</skos:notation>
    <skos:definition xml:lang="en">Soil properties, condition, degradation, contamination and functions.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry/agriculture_food_systems">
    <skos:prefLabel xml:lang="en">Agriculture &amp; Food Systems</skos:prefLabel>
    <skos:notation>agriculture_food_systems</skos:notation>
    <skos:definition xml:lang="en">Agricultural land, practices, production systems and environmental interactions of food systems.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry/forests_forestry">
    <skos:prefLabel xml:lang="en">Forests &amp; Forestry</skos:prefLabel>
    <skos:notation>forests_forestry</skos:notation>
    <skos:definition xml:lang="en">Forest extent, condition, resources, management and forestry-related environmental information.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/land_agriculture_soil_forestry" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management">
    <skos:prefLabel xml:lang="en">Freshwater and Water Management</skos:prefLabel>
    <skos:notation>freshwater_water_management</skos:notation>
    <skos:definition xml:lang="en">Inland water resources, their quantity and quality, use, pressures and management, including rivers, lakes, groundwater, water services and water-related risks.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:topConceptOf rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management/water_bodies_ecological_status" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management/water_quality_pollution" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management/water_resources_hydrology" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management/water_use_supply_sanitation" />
    <skos:narrower rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management/floods_droughts" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management/water_bodies_ecological_status">
    <skos:prefLabel xml:lang="en">Water Bodies &amp; Ecological Status</skos:prefLabel>
    <skos:notation>water_bodies_ecological_status</skos:notation>
    <skos:definition xml:lang="en">Characteristics and environmental/ecological status of inland water bodies.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management/water_quality_pollution">
    <skos:prefLabel xml:lang="en">Water Quality &amp; Pollution</skos:prefLabel>
    <skos:notation>water_quality_pollution</skos:notation>
    <skos:definition xml:lang="en">Chemical, biological and physical water quality and pollution pressures.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management/water_resources_hydrology">
    <skos:prefLabel xml:lang="en">Water Resources &amp; Hydrology</skos:prefLabel>
    <skos:notation>water_resources_hydrology</skos:notation>
    <skos:definition xml:lang="en">Water quantity, hydrological conditions, availability, flows, levels and resource balance.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management/water_use_supply_sanitation">
    <skos:prefLabel xml:lang="en">Water Use, Supply &amp; Sanitation</skos:prefLabel>
    <skos:notation>water_use_supply_sanitation</skos:notation>
    <skos:definition xml:lang="en">Abstraction, use, drinking-water supply, wastewater collection/treatment and reuse.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management/floods_droughts">
    <skos:prefLabel xml:lang="en">Floods &amp; Droughts</skos:prefLabel>
    <skos:notation>floods_droughts</skos:notation>
    <skos:definition xml:lang="en">Flood and drought hazards, risk, impacts and related management information.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/freshwater_water_management" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/marine_coastal_fisheries">
    <skos:prefLabel xml:lang="en">Marine, Coastal and Fisheries</skos:prefLabel>
    <skos:notation>marine_coastal_fisheries</skos:notation>
