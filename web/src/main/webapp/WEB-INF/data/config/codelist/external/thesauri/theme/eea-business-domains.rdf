    <skos:prefLabel xml:lang="en">Road Transport</skos:prefLabel>
    <skos:notation>road_transport</skos:notation>
    <skos:definition xml:lang="en">Road-based passenger and freight transport, vehicles, fleets and road-transport activity.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/transport_mobility" />
  </skos:Concept>
  <skos:Concept rdf:about="https://sdi.eea.europa.eu/registry/business-domains/transport_mobility/rail_transport">
    <skos:prefLabel xml:lang="en">Rail Transport</skos:prefLabel>
    <skos:notation>rail_transport</skos:notation>
    <skos:definition xml:lang="en">Passenger and freight rail transport and associated activity.</skos:definition>
    <skos:inScheme rdf:resource="https://sdi.eea.europa.eu/registry/business-domains" />
    <skos:broader rdf:resource="https://sdi.eea.europa.eu/registry/business-domains/transport_mobility" />
  </skos:Concept>
